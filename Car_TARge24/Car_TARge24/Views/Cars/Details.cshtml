@model Car_TARge24.Models.Cars.CarDetailsViewModel

@{
    ViewData["Title"] = "Car Details";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4"> Car Details</h2>

    <table class="table table-borderless" style="max-width: 500px;">
        <tbody>
            <tr>
                <th class="text-muted">ID</th>
                <td>@Html.DisplayFor(model => model.Id)</td>
            </tr>
            <tr>
                <th class="text-muted">Brand</th>
                <td id="testIdBrand_D">@Html.DisplayFor(model => model.Brand)</td>
            </tr>
            <tr>
                <th class="text-muted">Model</th>
                <td id="testIdModel_D">@Html.DisplayFor(model => model.Model)</td>
            </tr>
            <tr>
                <th class="text-muted">EnginePower</th>
                <td id="testIdEnginePower_D">@Html.DisplayFor(model => model.EnginePower) HP</td>
            </tr>
            <tr>
                <th class="text-muted">Year</th>
                <td id="testIdYear_D">@Html.DisplayFor(model => model.Year)</td>
            </tr>
            <tr>
                <th class="text-muted">FuelConsumption</th>
                <td id="testIdFuelConsumption_D">@Html.DisplayFor(model => model.FuelConsumption) L/100km</td>
            </tr>
            <tr>
                <th class="text-muted">CreatedAt</th>
                <td>@Html.DisplayFor(model => model.CreatedAt)</td>
            </tr>
            <tr>
                <th class="text-muted">UpdatedAt</th>
                <td>@Html.DisplayFor(model => model.UpdatedAt)</td>
            </tr>
        </tbody>
    </table>

    <hr />

    <div class="d-flex gap-2">
        <a asp-action="Index" asp-controller="cars" class="btn btn-primary" id="BackButtonAction">← Back</a>
    </div>
</div>
