@model Car_TARge24.Models.Cars.CarDeleteViewModel

@{
    ViewData["Title"] = "Delete Car";
}

<div class="container mt-4">
    <h2 class="fw-bold text-danger mb-4"> Delete Car</h2>

    <div class="alert alert-warning" style="max-width: 500px;">
        <strong>Are you sure you want to delete this car?</strong>
        <p class="mb-0">This action cannot be undone.</p>
    </div>

    <table class="table table-borderless" style="max-width: 500px;">
        <tbody>
            <tr>
                <th class="text-muted">ID</th>
                <td>@Html.DisplayFor(model => model.Id)</td>
            </tr>
            <tr>
                <th class="text-muted">Brand</th>
                <td>@Html.DisplayFor(model => model.Brand)</td>
            </tr>
            <tr>
                <th class="text-muted">Model</th>
                <td>@Html.DisplayFor(model => model.Model)</td>
            </tr>
            <tr>
                <th class="text-muted">EnginePower</th>
                <td>@Html.DisplayFor(model => model.EnginePower) HP</td>
            </tr>
            <tr>
                <th class="text-muted">Year</th>
                <td>@Html.DisplayFor(model => model.Year)</td>
            </tr>
            <tr>
                <th class="text-muted">FuelConsumption</th>
                <td>@Html.DisplayFor(model => model.FuelConsumption) L/100km</td>
            </tr>
            <tr>
                <th class="text-muted">CreatedAt</th>
                <td>@Html.DisplayFor(model => model.CreatedAt)</td>
            </tr>
            <tr>
                <th class="text-muted">UpdatedAt</th>
                <td>@Html.DisplayFor(model => model.UpdatedAt)</td>
            </tr>
        </tbody>
    </table>

    <hr />

    <form asp-action="DeleteConfirmation">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <a asp-action="Index" asp-controller="cars" class="btn btn-primary" id="BackButtonAction">← Back</a>
            <button type="submit" class="btn btn-danger" id="DeleteButtonAction"> Delete</button>
        </div>
    </form>
</div>
