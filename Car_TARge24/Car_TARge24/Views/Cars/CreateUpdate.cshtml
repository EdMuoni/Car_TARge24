@model Car_TARge24.Models.Cars.CarCreateUpdateViewModel

@{
    ViewData["Title"] = Model.Id.HasValue ? "Update" : "Add New Car";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        @if (Model.Id.HasValue)
                        {
                            <span>Update </span>
                        }
                        else
                        {
                            <span>Add New Car</span>
                        }
                    </h4>
                </div>

                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label asp-for="Brand" class="form-label fw-bold">Brand</label>
                            <input asp-for="Brand"
                                   class="form-control"
                                   id="BrandInput" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="form-label fw-bold">Model</label>
                            <input asp-for="Model"
                                   class="form-control"
                                   id="ModelInput"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EnginePower" class="form-label fw-bold">EnginePower (HP)</label>
                            <input asp-for="EnginePower"
                                   type="number"
                                   class="form-control"
                                   id="EnginePowerInput"/>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label fw-bold">Year</label>
                            <input asp-for="Year"
                                   type="number"
                                   class="form-control"
                                   id="YearInput"
                                   min="1900"
                                   max="2030" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FuelConsumption" class="form-label fw-bold">FuelConsumption (L/100km)</label>
                            <input asp-for="FuelConsumption"
                                   type="number"
                                   class="form-control"
                                   id="FuelConsumptionInput"/>
                        </div>

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="CreatedAt" type="hidden" />
                        <input asp-for="UpdatedAt" type="hidden" />

                        <hr />

                        <div class="d-flex justify-content-between">

                            <a asp-action="Index"
                               asp-controller="cars"
                               class="btn btn-primary"
                               id="BackButtonAction">
                                ← Back
                            </a>

                            @if (Model.Id.HasValue)
                            {
                                <button asp-action="update"
                                        asp-controller="cars"
                                        type="submit"
                                        class="btn btn-success"
                                        id="UpdateButtonAction">
                                    ✓ Update
                                </button>
                            }
                            else
                            {
                                <button asp-action="create"
                                        asp-controller="cars"
                                        type="submit"
                                        class="btn btn-success"
                                        id="CreateButtonAction">
                                    + Create
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
